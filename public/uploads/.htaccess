# Folder unggahan: hanya gambar, tidak pernah dieksekusi sebagai skrip.
php_flag engine off

<FilesMatch "\.(php|phtml|php\d|phar|cgi|pl|py|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
